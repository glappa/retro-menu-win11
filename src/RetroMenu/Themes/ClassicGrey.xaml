<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Grey 9x/2000 palette: square corners, 3D face grey, navy highlight.
        Used for RetroBar's Windows 95-98, Windows 2000, Me and Classic themes.
    -->

    <FontFamily x:Key="MenuFontFamily">Tahoma</FontFamily>
    <sys:Double x:Key="MenuFontSize">12</sys:Double>
    <sys:Double x:Key="UserNameFontSize">14</sys:Double>

    <CornerRadius x:Key="MenuCornerRadius">0</CornerRadius>
    <Thickness x:Key="MenuBorderThickness">1</Thickness>
    <sys:Double x:Key="HeaderHeight">44</sys:Double>
    <sys:Double x:Key="FooterHeight">34</sys:Double>

    <SolidColorBrush x:Key="MenuBorderBrush" Color="#FF404040" />

    <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0A246A" Offset="0" />
        <GradientStop Color="#FFA6CAF0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="HeaderForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="UserTileBorder" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="LeftPaneBackground" Color="#FFD4D0C8" />
    <SolidColorBrush x:Key="RightPaneBackground" Color="#FFC3BFB7" />

    <SolidColorBrush x:Key="LeftPaneForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="RightPaneForeground" Color="#FF000000" />

    <SolidColorBrush x:Key="ItemHighlightBackground" Color="#FF000080" />
    <SolidColorBrush x:Key="ItemHighlightForeground" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="SeparatorBrush" Color="#FF808080" />
    <SolidColorBrush x:Key="RightSeparatorBrush" Color="#FF808080" />

    <SolidColorBrush x:Key="AllProgramsBackground" Color="#FFD4D0C8" />
    <SolidColorBrush x:Key="AllProgramsForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="AllProgramsArrowBackground" Color="#FF000080" />

    <SolidColorBrush x:Key="FooterBackground" Color="#FFD4D0C8" />
    <SolidColorBrush x:Key="FooterLineBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FooterForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="FooterButtonHover" Color="#30000080" />

    <SolidColorBrush x:Key="CascadeBackground" Color="#FFD4D0C8" />
    <SolidColorBrush x:Key="CascadeBorder" Color="#FF808080" />
    <SolidColorBrush x:Key="CascadeForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="CascadeHighlight" Color="#FF000080" />
    <SolidColorBrush x:Key="CascadeHighlightForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CascadeSeparator" Color="#FF808080" />

    <SolidColorBrush x:Key="SearchBoxBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SearchBoxBorder" Color="#FF808080" />
    <SolidColorBrush x:Key="SearchBoxForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="SearchHintForeground" Color="#FF808080" />

</ResourceDictionary>
