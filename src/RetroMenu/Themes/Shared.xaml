<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Control styles shared by every theme. All colours come in via DynamicResource
        so swapping the theme dictionary restyles a menu that is already on screen.

        The three little pictures at the bottom of XP's panel — the green All
        Programs arrow, the amber key on Log Off and the red power button — stayed
        the same across all Luna colour schemes, so they live here rather than in
        the themes.
    -->

    <LinearGradientBrush x:Key="AllProgramsArrowFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF7BD84F" Offset="0" />
        <GradientStop Color="#FF52BE2C" Offset="0.5" />
        <GradientStop Color="#FF0E8206" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AllProgramsArrowStroke" Color="#FF00520A" />

    <LinearGradientBrush x:Key="LogOffIconBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFEFCB96" Offset="0" />
        <GradientStop Color="#FFDC9B37" Offset="0.5" />
        <GradientStop Color="#FF8F5400" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PowerIconBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF0A492" Offset="0" />
        <GradientStop Color="#FFE45A35" Offset="0.5" />
        <GradientStop Color="#FF951700" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="IconGlyphBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="IconEdgeBrush" Color="#59FFFFFF" />

    <!--
        Both footer icons are drawn on a 32 unit square and shown through an Image,
        so they sit exactly centred at any size and stay sharp when the menu is
        scaled up. The earlier version put a 22 unit canvas inside a 20 unit box,
        which pushed the glyph a pixel down and to the right.
    -->
    <LinearGradientBrush x:Key="IconGlossBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#70FFFFFF" Offset="0" />
        <GradientStop Color="#20FFFFFF" Offset="0.75" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <DrawingImage x:Key="LogOffIconImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource LogOffIconBackground}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IconEdgeBrush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0.5,0.5,31,31" RadiusX="4.5" RadiusY="4.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing Brush="{StaticResource IconGlossBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="2,2,28,13" RadiusX="3.5" RadiusY="3.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- a key: bow at the lower left, shaft up to the right, two teeth -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IconGlyphBrush}" Thickness="2.6"
                             StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="11,21" RadiusX="4.2" RadiusY="4.2" />
                            <LineGeometry StartPoint="14,18" EndPoint="23.5,8.5" />
                            <LineGeometry StartPoint="19.4,12.6" EndPoint="22,15.2" />
                            <LineGeometry StartPoint="21.6,10.4" EndPoint="23.8,12.6" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="PowerIconImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource PowerIconBackground}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IconEdgeBrush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0.5,0.5,31,31" RadiusX="4.5" RadiusY="4.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <GeometryDrawing Brush="{StaticResource IconGlossBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="2,2,28,13" RadiusX="3.5" RadiusY="3.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- ring and bar, both centred on the same point -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource IconGlyphBrush}" Thickness="2.6"
                             StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="16,17.5" RadiusX="7.4" RadiusY="7.4" />
                            <LineGeometry StartPoint="16,10.6" EndPoint="16,17.6" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--
        A row in the left or the right column. XP drew the hover state as a flat
        rectangle in one solid blue, with square corners.
    -->
    <Style x:Key="MenuEntryButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ItemHighlightBackground}" />
                            <Setter TargetName="Bd" Property="TextElement.Foreground"
                                    Value="{DynamicResource ItemHighlightForeground}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ItemHighlightBackground}" />
                            <Setter TargetName="Bd" Property="TextElement.Foreground"
                                    Value="{DynamicResource ItemHighlightForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The two buttons on the blue bar at the bottom. -->
    <Style x:Key="FooterItemButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource FooterButtonHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A tick box in the plain, square style of the era. -->
    <Style x:Key="RetroCheckBox" TargetType="CheckBox">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="12" Height="12" Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SearchBoxBackground}"
                                BorderBrush="{DynamicResource SearchBoxBorder}"
                                BorderThickness="1">
                            <Path x:Name="Tick" Visibility="Collapsed"
                                  Margin="1.5" Stretch="Uniform"
                                  Data="M 0,3.4 L 2.9,6.3 L 8,0.7"
                                  Stroke="{DynamicResource LeftPaneForeground}"
                                  StrokeThickness="1.7" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"
                                    Value="{DynamicResource ItemHighlightBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ cascading All Programs menu ============ -->

    <ControlTemplate x:Key="RetroSubmenuItem" TargetType="MenuItem">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                  Margin="2,1,2,1" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="False"
                                  Margin="3,2,16,2" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CascadeHighlight}" />
                <Setter TargetName="Bd" Property="TextElement.Foreground"
                        Value="{DynamicResource CascadeHighlightForeground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#FF9A9A9A" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="RetroSubmenuHeader" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                      Margin="2,1,2,1" VerticalAlignment="Center" />
                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                      RecognizesAccessKey="False"
                                      Margin="3,2,16,2" VerticalAlignment="Center" />
                    <Path x:Name="Arrow" Grid.Column="2" Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          Data="M 0,0 L 3.5,3.5 L 0,7 Z"
                          Fill="{DynamicResource CascadeForeground}" />
                </Grid>
            </Border>
            <Popup x:Name="PART_Popup" Placement="Right"
                   HorizontalOffset="-3" VerticalOffset="-4"
                   AllowsTransparency="True" Focusable="False"
                   PopupAnimation="None"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Background="{DynamicResource CascadeBackground}"
                        BorderBrush="{DynamicResource CascadeBorder}"
                        BorderThickness="1" Padding="1"
                        SnapsToDevicePixels="True">
                    <ScrollViewer CanContentScroll="True"
                                  Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                        SnapsToDevicePixels="True" />
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CascadeHighlight}" />
                <Setter TargetName="Bd" Property="TextElement.Foreground"
                        Value="{DynamicResource CascadeHighlightForeground}" />
                <Setter TargetName="Arrow" Property="Fill"
                        Value="{DynamicResource CascadeHighlightForeground}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource CascadeForeground}" />
        <Setter Property="FontFamily" Value="{DynamicResource MenuFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource MenuFontSize}" />
        <Setter Property="Template" Value="{StaticResource RetroSubmenuItem}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource RetroSubmenuHeader}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource CascadeForeground}" />
        <Setter Property="FontFamily" Value="{DynamicResource MenuFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource MenuFontSize}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource CascadeBackground}"
                            BorderBrush="{DynamicResource CascadeBorder}"
                            BorderThickness="1" Padding="1"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True"
                                      Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                            SnapsToDevicePixels="True" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="24,3,2,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{DynamicResource CascadeSeparator}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
