<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Control styles shared by every theme. All colours come in via DynamicResource
        so swapping the theme dictionary restyles a menu that is already on screen.
    -->

    <!-- A row in the left column or the right column. -->
    <Style x:Key="MenuEntryButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ItemHighlightBackground}" />
                            <Setter TargetName="Bd" Property="TextElement.Foreground"
                                    Value="{DynamicResource ItemHighlightForeground}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ItemHighlightBackground}" />
                            <Setter TargetName="Bd" Property="TextElement.Foreground"
                                    Value="{DynamicResource ItemHighlightForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- "All Programs" and the two footer buttons. -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource FooterButtonHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AllProgramsButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="8,4">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ItemHighlightBackground}" />
                            <Setter TargetName="Bd" Property="TextElement.Foreground"
                                    Value="{DynamicResource ItemHighlightForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ cascading All Programs menu ============ -->

    <ControlTemplate x:Key="RetroSubmenuItem" TargetType="MenuItem">
        <Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                  Margin="3,2,3,2" VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                  RecognizesAccessKey="False"
                                  Margin="3,3,16,3" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CascadeHighlight}" />
                <Setter TargetName="Bd" Property="TextElement.Foreground"
                        Value="{DynamicResource CascadeHighlightForeground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="#FF9A9A9A" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="RetroSubmenuHeader" TargetType="MenuItem">
        <Grid>
            <Border x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                      Margin="3,2,3,2" VerticalAlignment="Center" />
                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                      RecognizesAccessKey="False"
                                      Margin="3,3,16,3" VerticalAlignment="Center" />
                    <Path x:Name="Arrow" Grid.Column="2" Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          Data="M 0,0 L 4,4 L 0,8 Z"
                          Fill="{DynamicResource CascadeForeground}" />
                </Grid>
            </Border>
            <Popup x:Name="PART_Popup" Placement="Right"
                   HorizontalOffset="-3" VerticalOffset="-4"
                   AllowsTransparency="True" Focusable="False"
                   PopupAnimation="None"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Background="{DynamicResource CascadeBackground}"
                        BorderBrush="{DynamicResource CascadeBorder}"
                        BorderThickness="1" Padding="1"
                        SnapsToDevicePixels="True">
                    <ScrollViewer CanContentScroll="True"
                                  Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                        SnapsToDevicePixels="True" />
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CascadeHighlight}" />
                <Setter TargetName="Bd" Property="TextElement.Foreground"
                        Value="{DynamicResource CascadeHighlightForeground}" />
                <Setter TargetName="Arrow" Property="Fill"
                        Value="{DynamicResource CascadeHighlightForeground}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource CascadeForeground}" />
        <Setter Property="FontFamily" Value="{DynamicResource MenuFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource MenuFontSize}" />
        <Setter Property="Template" Value="{StaticResource RetroSubmenuItem}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource RetroSubmenuHeader}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource CascadeForeground}" />
        <Setter Property="FontFamily" Value="{DynamicResource MenuFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource MenuFontSize}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource CascadeBackground}"
                            BorderBrush="{DynamicResource CascadeBorder}"
                            BorderThickness="1" Padding="1"
                            SnapsToDevicePixels="True">
                        <ScrollViewer CanContentScroll="True"
                                      Style="{DynamicResource {ComponentResourceKey ResourceId=MenuScrollViewer, TypeInTargetAssembly={x:Type FrameworkElement}}}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                            SnapsToDevicePixels="True" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="24,3,2,3" />
        <Setter Property="Background" Value="{DynamicResource CascadeSeparator}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{DynamicResource CascadeSeparator}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
