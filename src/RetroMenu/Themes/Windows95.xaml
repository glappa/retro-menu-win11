<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Windows 95. Silver 3D face, navy selection, MS Sans Serif.

        The 9x family drew a single column with a coloured strip down the left
        edge carrying the version name. Colours are the system 3D palette of the
        era; the strip is solid navy with white lettering, measured off the
        original bitmap rather than guessed.
    -->

    <sys:String x:Key="MenuLayout">Classic</sys:String>
    <sys:String x:Key="BannerText">Windows 95</sys:String>

    <FontFamily x:Key="MenuFontFamily">MS Sans Serif, Microsoft Sans Serif, Tahoma</FontFamily>
    <sys:Double x:Key="MenuFontSize">11</sys:Double>
    <sys:Double x:Key="UserNameFontSize">14</sys:Double>
    <sys:Double x:Key="BannerWidth">22</sys:Double>
    <sys:Double x:Key="BannerFontSize">15</sys:Double>
    <sys:Double x:Key="ClassicItemHeight">36</sys:Double>

    <CornerRadius x:Key="MenuCornerRadius">0</CornerRadius>
    <sys:Double x:Key="HeaderHeight">0</sys:Double>
    <sys:Double x:Key="FooterHeight">0</sys:Double>

    <!-- 3D system colours -->
    <SolidColorBrush x:Key="MenuFaceBrush" Color="#FFC0C0C0" />
    <SolidColorBrush x:Key="Light3DBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Shadow3DBrush" Color="#FF808080" />
    <SolidColorBrush x:Key="DarkShadow3DBrush" Color="#FF000000" />

    <LinearGradientBrush x:Key="BannerBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF000080" Offset="0" />
        <GradientStop Color="#FF1A1AA0" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BannerForeground" Color="#FFFFFFFF" />

    <!-- shared keys, so the panel layout stays loadable under a classic theme -->
    <SolidColorBrush x:Key="FrameBrush" Color="#FFC0C0C0" />
    <SolidColorBrush x:Key="HeaderBackground" Color="#FF000080" />
    <SolidColorBrush x:Key="HeaderTopHighlight" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="HeaderForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="UserTileBorder" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="OrangeLineBrush" Color="#FF808080" />
    <SolidColorBrush x:Key="MenuTopLineBrush" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="LeftPaneBackground" Color="#FFC0C0C0" />
    <SolidColorBrush x:Key="RightPaneBackground" Color="#FFC0C0C0" />
    <SolidColorBrush x:Key="ColumnDividerBrush" Color="#FF808080" />

    <SolidColorBrush x:Key="LeftPaneForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="RightPaneForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="SubtextForeground" Color="#99000000" />

    <SolidColorBrush x:Key="ItemHighlightBackground" Color="#FF000080" />
    <SolidColorBrush x:Key="ItemHighlightForeground" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="LeftSeparatorBrush" Color="#FF808080" />
    <SolidColorBrush x:Key="RightSeparatorBrush" Color="#FF808080" />

    <SolidColorBrush x:Key="ArrowBrush" Color="#FF000000" />

    <SolidColorBrush x:Key="FooterBackground" Color="#FFC0C0C0" />
    <SolidColorBrush x:Key="FooterForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="FooterButtonHover" Color="#30000000" />

    <SolidColorBrush x:Key="CascadeBackground" Color="#FFC0C0C0" />
    <SolidColorBrush x:Key="CascadeBorder" Color="#FF808080" />
    <SolidColorBrush x:Key="CascadeForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="CascadeHighlight" Color="#FF000080" />
    <SolidColorBrush x:Key="CascadeHighlightForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NewItemHighlight" Color="#FFD8D8C8" />
    <SolidColorBrush x:Key="CascadeSeparator" Color="#FF808080" />

    <SolidColorBrush x:Key="SearchBoxBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SearchBoxBorder" Color="#FF808080" />
    <SolidColorBrush x:Key="SearchBoxForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="SearchHintForeground" Color="#FF808080" />

</ResourceDictionary>
