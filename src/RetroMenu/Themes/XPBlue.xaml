<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        Windows XP Luna, blue. Gradients, sizes and colours measured off the real
        start panel, so every stop below is deliberate.
    -->

    <sys:String x:Key="MenuLayout">Panel</sys:String>

    <FontFamily x:Key="MenuFontFamily">Tahoma</FontFamily>
    <sys:Double x:Key="MenuFontSize">11</sys:Double>
    <sys:Double x:Key="UserNameFontSize">15</sys:Double>

    <CornerRadius x:Key="MenuCornerRadius">5,5,0,0</CornerRadius>
    <sys:Double x:Key="HeaderHeight">66</sys:Double>
    <sys:Double x:Key="FooterHeight">36</sys:Double>

    <!-- the 2px frame left and right of the two columns -->
    <SolidColorBrush x:Key="FrameBrush" Color="#FF4282D6" />

    <LinearGradientBrush x:Key="HeaderBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1868CE" Offset="0" />
        <GradientStop Color="#FF0E60CB" Offset="0.12" />
        <GradientStop Color="#FF0E60CB" Offset="0.20" />
        <GradientStop Color="#FF1164CF" Offset="0.32" />
        <GradientStop Color="#FF1667CF" Offset="0.33" />
        <GradientStop Color="#FF1B6CD3" Offset="0.47" />
        <GradientStop Color="#FF1E70D9" Offset="0.54" />
        <GradientStop Color="#FF2476DC" Offset="0.60" />
        <GradientStop Color="#FF297AE0" Offset="0.65" />
        <GradientStop Color="#FF3482E3" Offset="0.77" />
        <GradientStop Color="#FF3786E5" Offset="0.79" />
        <GradientStop Color="#FF428EE9" Offset="0.90" />
        <GradientStop Color="#FF4791EB" Offset="1" />
    </LinearGradientBrush>

    <!-- the thin light band along the very top edge of the header -->
    <LinearGradientBrush x:Key="HeaderTopHighlight" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#4DFFFFFF" Offset="0.01" />
        <GradientStop Color="#80FFFFFF" Offset="0.02" />
        <GradientStop Color="#80FFFFFF" Offset="0.95" />
        <GradientStop Color="#4DFFFFFF" Offset="0.98" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HeaderForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="UserTileBorder" Color="#CCDEDEDE" />

    <!-- the orange hairline right under the header, one of Luna's signatures -->
    <LinearGradientBrush x:Key="OrangeLineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00DA884A" Offset="0" />
        <GradientStop Color="#FFDA884A" Offset="0.5" />
        <GradientStop Color="#00DA884A" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MenuTopLineBrush" Color="#FF385DE7" />

    <SolidColorBrush x:Key="LeftPaneBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RightPaneBackground" Color="#FFCBE3FF" />
    <SolidColorBrush x:Key="ColumnDividerBrush" Color="#5E3A3AFF" />

    <SolidColorBrush x:Key="LeftPaneForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="RightPaneForeground" Color="#FF00136B" />
    <SolidColorBrush x:Key="SubtextForeground" Color="#66000000" />

    <SolidColorBrush x:Key="ItemHighlightBackground" Color="#FF2F71CD" />
    <SolidColorBrush x:Key="ItemHighlightForeground" Color="#FFFFFFFF" />

    <LinearGradientBrush x:Key="LeftSeparatorBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#1A000000" Offset="0.5" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RightSeparatorBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0087B3E2" Offset="0" />
        <GradientStop Color="#B587B3E2" Offset="0.5" />
        <GradientStop Color="#0087B3E2" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ArrowBrush" Color="#FF00136B" />

    <LinearGradientBrush x:Key="FooterBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF4282D6" Offset="0" />
        <GradientStop Color="#FF3B85E0" Offset="0.03" />
        <GradientStop Color="#FF418AE3" Offset="0.05" />
        <GradientStop Color="#FF418AE3" Offset="0.17" />
        <GradientStop Color="#FF3C87E2" Offset="0.21" />
        <GradientStop Color="#FF3786E4" Offset="0.26" />
        <GradientStop Color="#FF3482E3" Offset="0.29" />
        <GradientStop Color="#FF2E7EE1" Offset="0.39" />
        <GradientStop Color="#FF2374DF" Offset="0.49" />
        <GradientStop Color="#FF2072DB" Offset="0.57" />
        <GradientStop Color="#FF196EDB" Offset="0.62" />
        <GradientStop Color="#FF176BD8" Offset="0.72" />
        <GradientStop Color="#FF1468D5" Offset="0.75" />
        <GradientStop Color="#FF1165D2" Offset="0.83" />
        <GradientStop Color="#FF0F61CB" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="FooterForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FooterButtonHover" Color="#803C50D2" />

    <!-- the cascading All Programs flyout keeps XP's plain menu look -->
    <SolidColorBrush x:Key="CascadeBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CascadeBorder" Color="#FFACA899" />
    <SolidColorBrush x:Key="CascadeForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="CascadeHighlight" Color="#FF316AC5" />
    <SolidColorBrush x:Key="CascadeHighlightForeground" Color="#FFFFFFFF" />
    <!-- background behind a program installed since the menu last looked -->
    <SolidColorBrush x:Key="NewItemHighlight" Color="#FFCCE0F5" />
    <SolidColorBrush x:Key="CascadeSeparator" Color="#FFACA899" />

    <SolidColorBrush x:Key="SearchBoxBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SearchBoxBorder" Color="#FF7F9DB9" />
    <SolidColorBrush x:Key="SearchBoxForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="SearchHintForeground" Color="#FF808080" />

</ResourceDictionary>
