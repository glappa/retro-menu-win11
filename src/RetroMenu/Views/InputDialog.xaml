<Window x:Class="RetroMenu.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retro Menu"
        Width="340" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Tahoma" FontSize="12"
        Background="#FFF0F0F0">

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Padding" Value="18,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FFECECEC" BorderBrush="#FF7B7B7B"
                                BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF2F71CD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8" TextWrapping="Wrap" />
        <Border Background="White" BorderBrush="#FF7F9DB9" BorderThickness="1" Padding="4,3">
            <TextBox x:Name="Input" BorderThickness="0" Background="Transparent"
                     KeyDown="OnKeyDown" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Click="OnCancel" />
            <Button x:Name="OkButton" Style="{StaticResource DialogButton}" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
