<Window x:Class="RetroMenu.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retro Menu"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource MenuFontFamily}"
        FontSize="{DynamicResource MenuFontSize}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" Padding="14,10">
            <TextBlock x:Name="HeaderText" FontWeight="Bold" FontSize="15"
                       Foreground="{DynamicResource HeaderForeground}" />
        </Border>

        <StackPanel Grid.Row="1" Margin="16,14,16,6">
            <TextBlock x:Name="AppearanceLabel" FontWeight="Bold" Margin="0,0,0,6" />

            <DockPanel Margin="0,0,0,6">
                <TextBlock x:Name="ThemeLabel" Width="150" VerticalAlignment="Center" />
                <ComboBox x:Name="ThemeBox" SelectionChanged="OnThemeChanged" />
            </DockPanel>

            <CheckBox x:Name="FollowRetroBarBox" Margin="0,0,0,4" Click="OnFollowChanged" />
            <TextBlock x:Name="RetroBarStatus" Opacity="0.7" Margin="20,0,0,10" TextWrapping="Wrap" />

            <DockPanel Margin="0,0,0,12">
                <TextBlock x:Name="LanguageLabel" Width="150" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageBox" SelectionChanged="OnLanguageChanged" />
            </DockPanel>

            <TextBlock x:Name="BehaviourLabel" FontWeight="Bold" Margin="0,0,0,6" />

            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="WinKeyLabel" Width="150" VerticalAlignment="Center" />
                <ComboBox x:Name="WinKeyBox" SelectionChanged="OnWinKeyChanged" />
            </DockPanel>

            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="FrequentLabel" Width="150" VerticalAlignment="Center" />
                <ComboBox x:Name="FrequentBox" SelectionChanged="OnFrequentChanged" />
            </DockPanel>

            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="ScaleLabel" Width="150" VerticalAlignment="Center" />
                <ComboBox x:Name="ScaleBox" SelectionChanged="OnScaleChanged" />
            </DockPanel>

            <CheckBox x:Name="KeepTaskbarToggle" Margin="0,0,0,5" Click="OnToggleChanged" />
            <CheckBox x:Name="SearchBoxToggle" Margin="0,0,0,5" Click="OnToggleChanged" />
            <CheckBox x:Name="StoreAppsToggle" Margin="0,0,0,5" Click="OnToggleChanged" />
            <CheckBox x:Name="AutoStartToggle" Margin="0,0,0,5" Click="OnAutoStartChanged" />
        </StackPanel>

        <Border Grid.Row="2" Padding="16,8,16,12">
            <DockPanel>
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" Opacity="0.6" />
                <Button x:Name="CloseButton" HorizontalAlignment="Right" Padding="18,4"
                        Click="OnClose" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
