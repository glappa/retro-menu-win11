<Window x:Class="RetroMenu.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retro Menu einrichten"
        Width="520" Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Tahoma"
        FontSize="12"
        Background="#FFF0F0F0">

    <Window.Resources>
        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="Padding" Value="20,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FFECECEC" BorderBrush="#FF7B7B7B"
                                BorderThickness="1" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF2F71CD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- the blue band, same gradient the menu header uses -->
        <Border Grid.Row="0" Height="66" Padding="18,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF1868CE" Offset="0" />
                    <GradientStop Color="#FF2476DC" Offset="0.6" />
                    <GradientStop Color="#FF4791EB" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Retro Menu einrichten" FontSize="17" FontWeight="Bold"
                           Foreground="White" />
                <TextBlock x:Name="Subtitle" Foreground="#DDFFFFFF" Margin="0,3,0,0"
                           Text="Ein Startmenü im Stil älterer Windows-Versionen." />
            </StackPanel>
        </Border>

        <Rectangle Grid.Row="0" Height="2" VerticalAlignment="Bottom">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00DA884A" Offset="0" />
                    <GradientStop Color="#FFDA884A" Offset="0.5" />
                    <GradientStop Color="#00DA884A" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============ options ============ -->
        <StackPanel x:Name="OptionsPanel" Grid.Row="1" Margin="18,16,18,0">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Das Programm wird in Ihren eigenen Benutzerordner gelegt. Es sind keine Administratorrechte nötig, und es wird nichts am System verändert." />

            <TextBlock Text="Zielordner" FontWeight="Bold" Margin="0,0,0,3" />
            <Border Background="White" BorderBrush="#FF7F9DB9" BorderThickness="1" Padding="5,3"
                    Margin="0,0,0,14">
                <TextBlock x:Name="PathText" TextTrimming="CharacterEllipsis" />
            </Border>

            <TextBlock Text="Beim Einrichten" FontWeight="Bold" Margin="0,0,0,6" />
            <CheckBox x:Name="StartMenuBox" Margin="0,0,0,6" IsChecked="True"
                      Content="Verknüpfung im Startmenü anlegen" />
            <CheckBox x:Name="DesktopBox" Margin="0,0,0,6"
                      Content="Verknüpfung auf dem Desktop anlegen" />
            <CheckBox x:Name="AutoStartBox" Margin="0,0,0,6" IsChecked="True"
                      Content="Mit Windows starten" />
            <CheckBox x:Name="RetroBarBox" Margin="0,0,0,2"
                      Content="RetroBar mitinstallieren – die Taskleiste im XP-Stil" />
            <TextBlock x:Name="RetroBarNote" Margin="20,0,0,0" Opacity="0.7" TextWrapping="Wrap"
                       Text="Wird direkt von github.com/dremin/RetroBar geladen. Die Prüfsumme des Downloads steht anschließend im Protokoll." />
        </StackPanel>

        <!-- ============ progress ============ -->
        <Grid x:Name="ProgressPanel" Grid.Row="1" Margin="18,16,18,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Grid.Row="0" FontWeight="Bold" Margin="0,0,0,8" />
            <Border Grid.Row="1" Background="White" BorderBrush="#FF7F9DB9" BorderThickness="1">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="6,4">
                    <TextBlock x:Name="LogText" TextWrapping="Wrap" FontFamily="Consolas, Courier New"
                               FontSize="11" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ buttons ============ -->
        <Border Grid.Row="2" Background="#FFE8E8E8" BorderBrush="#FFCFCFCF"
                BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" Opacity="0.6" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource WizardButton}"
                            Content="Abbrechen" Click="OnCancel" />
                    <Button x:Name="InstallButton" Style="{StaticResource WizardButton}"
                            Content="Installieren" Click="OnInstall" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
