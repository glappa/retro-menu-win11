<Window x:Class="RetroMenu.Views.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RetroMenu.Views"
        Title="Retro Menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Width="452" Height="548"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource MenuFontFamily}"
        FontSize="{DynamicResource MenuFontSize}">

    <Window.Resources>

        <DataTemplate x:Key="ProgramTemplate">
            <Button Style="{StaticResource MenuEntryButton}" Padding="6,3"
                    ToolTip="{Binding Tooltip}" Tag="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="32" Height="32" Margin="0,0,7,0"
                           Source="{Binding LargeIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               MaxWidth="168" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PlaceTemplate">
            <Button Style="{StaticResource MenuEntryButton}" Padding="8,2" Tag="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="24" Height="24" Margin="0,0,7,0"
                           Source="{Binding LargeIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               FontWeight="Bold" MaxWidth="150"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="RightSeparatorTemplate">
            <Rectangle Height="1" Margin="14,4,10,4"
                       Fill="{DynamicResource RightSeparatorBrush}" />
        </DataTemplate>

        <views:StartItemTemplateSelector x:Key="PlaceSelector"
                                         ItemTemplate="{StaticResource PlaceTemplate}"
                                         SeparatorTemplate="{StaticResource RightSeparatorTemplate}" />
    </Window.Resources>

    <Border x:Name="Root"
            Background="{DynamicResource LeftPaneBackground}"
            BorderBrush="{DynamicResource MenuBorderBrush}"
            BorderThickness="{DynamicResource MenuBorderThickness}"
            CornerRadius="{DynamicResource MenuCornerRadius}"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="315" Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ header ============ -->
            <Border Grid.Row="0"
                    Height="{DynamicResource HeaderHeight}"
                    Background="{DynamicResource HeaderBackground}"
                    CornerRadius="7,7,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0">
                        <Border Width="42" Height="42" CornerRadius="4"
                                BorderBrush="{DynamicResource UserTileBorder}"
                                BorderThickness="2" Background="#30FFFFFF">
                            <Image x:Name="UserPicture" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock x:Name="UserName" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource UserNameFontSize}"
                                   Foreground="{DynamicResource HeaderForeground}" />
                    </StackPanel>
                    <Rectangle Height="1" VerticalAlignment="Bottom"
                               Fill="{DynamicResource HeaderLineBrush}" Opacity="0.8" />
                </Grid>
            </Border>

            <!-- ============ body ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- left column -->
                <Border Grid.Column="0" Background="{DynamicResource LeftPaneBackground}"
                        TextElement.Foreground="{DynamicResource LeftPaneForeground}">
                    <DockPanel>
                        <Border DockPanel.Dock="Bottom"
                                Background="{DynamicResource AllProgramsBackground}"
                                Padding="4,3">
                            <Button x:Name="AllProgramsButton"
                                    Style="{StaticResource AllProgramsButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="OnAllProgramsClick">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="AllProgramsLabel" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AllProgramsForeground}" />
                                    <Border Width="16" Height="16" CornerRadius="2" Margin="7,0,0,0"
                                            Background="{DynamicResource AllProgramsArrowBackground}">
                                        <Path Data="M 0,0 L 4,4 L 0,8 Z" Fill="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </Border>

                        <Border x:Name="SearchHost" DockPanel.Dock="Bottom" Padding="7,4,7,5">
                            <Border Background="{DynamicResource SearchBoxBackground}"
                                    BorderBrush="{DynamicResource SearchBoxBorder}"
                                    BorderThickness="1" Padding="3,2">
                                <Grid>
                                    <TextBox x:Name="SearchBox" BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{DynamicResource SearchBoxForeground}"
                                             TextChanged="OnSearchTextChanged"
                                             KeyDown="OnSearchKeyDown" />
                                    <TextBlock x:Name="SearchHint" IsHitTestVisible="False"
                                               Margin="2,0,0,0"
                                               Foreground="{DynamicResource SearchHintForeground}" />
                                </Grid>
                            </Border>
                        </Border>

                        <Grid>
                            <ScrollViewer x:Name="NormalScroll" VerticalScrollBarVisibility="Auto"
                                          Padding="0,4,0,4">
                                <StackPanel Button.Click="OnItemClick"
                                            MouseRightButtonUp="OnItemRightClick">
                                    <ItemsControl x:Name="PinnedItems"
                                                  ItemTemplate="{StaticResource ProgramTemplate}"
                                                  Margin="4,0" />
                                    <Rectangle x:Name="PinnedSeparator" Height="1" Margin="10,5"
                                               Fill="{DynamicResource SeparatorBrush}" />
                                    <ItemsControl x:Name="FrequentItems"
                                                  ItemTemplate="{StaticResource ProgramTemplate}"
                                                  Margin="4,0" />
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer x:Name="SearchScroll" VerticalScrollBarVisibility="Auto"
                                          Visibility="Collapsed" Padding="0,4,0,4">
                                <StackPanel Button.Click="OnItemClick"
                                            MouseRightButtonUp="OnItemRightClick">
                                    <ItemsControl x:Name="SearchResults"
                                                  ItemTemplate="{StaticResource ProgramTemplate}"
                                                  Margin="4,0" />
                                    <TextBlock x:Name="NoResults" Margin="12,8"
                                               Visibility="Collapsed" Opacity="0.7" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- right column -->
                <Border Grid.Column="1" Background="{DynamicResource RightPaneBackground}"
                        TextElement.Foreground="{DynamicResource RightPaneForeground}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,6,0,6">
                        <ItemsControl x:Name="PlaceItems" Margin="4,0"
                                      ItemTemplateSelector="{StaticResource PlaceSelector}"
                                      Button.Click="OnItemClick" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============ footer ============ -->
            <Border Grid.Row="2"
                    Height="{DynamicResource FooterHeight}"
                    Background="{DynamicResource FooterBackground}"
                    TextElement.Foreground="{DynamicResource FooterForeground}">
                <Grid>
                    <Rectangle Height="1" VerticalAlignment="Top"
                               Fill="{DynamicResource FooterLineBrush}" Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="LogOffButton" Style="{StaticResource FlatButton}"
                                Padding="8,4" Margin="0,0,6,0" Click="OnLogOffClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="None"
                                      Stroke="{DynamicResource FooterForeground}" StrokeThickness="1.5"
                                      Data="M 6,2 L 2,2 L 2,14 L 6,14 M 8,8 L 14,8 M 11,5 L 14,8 L 11,11" />
                                <TextBlock x:Name="LogOffLabel" Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource FooterForeground}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ShutDownButton" Style="{StaticResource FlatButton}"
                                Padding="8,4" Click="OnShutDownClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="16" Height="16" Stretch="None"
                                      Stroke="{DynamicResource FooterForeground}" StrokeThickness="1.5"
                                      Data="M 8,2 L 8,8 M 4.3,4.4 A 5.2,5.2 0 1 0 11.7,4.4" />
                                <TextBlock x:Name="ShutDownLabel" Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource FooterForeground}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
