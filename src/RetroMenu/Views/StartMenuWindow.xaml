<Window x:Class="RetroMenu.Views.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RetroMenu.Views"
        Title="Retro Menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{DynamicResource MenuFontFamily}"
        FontSize="{DynamicResource MenuFontSize}">

    <Window.Resources>

        <!-- the grey second line under "Internet" / "E-mail" -->
        <Style x:Key="SubtextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtextForeground}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                             Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ItemHighlightForeground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlaceArrowStyle" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource ArrowBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                             Value="True">
                    <Setter Property="Fill" Value="{DynamicResource ItemHighlightForeground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- left column: 34px row, 30px icon, arrow when it is a favourites folder -->
        <DataTemplate x:Key="LeftItemTemplate">
            <Button Style="{StaticResource MenuEntryButton}" Height="34" Margin="0,0,0,4"
                    ToolTip="{Binding Tooltip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="30" Height="30" Margin="0,0,3,0"
                           Source="{Binding LargeIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="{Binding TitleWeight}"
                                   MaxWidth="135" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Subtext}" MaxWidth="135"
                                   Visibility="{Binding SubtextVisibility}"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource SubtextStyle}" />
                    </StackPanel>
                    <Path Grid.Column="2" Margin="3,0,2,0" VerticalAlignment="Center"
                          Data="M 0,0 L 3.5,3.5 L 0,7 Z"
                          Visibility="{Binding ArrowVisibility}"
                          Style="{StaticResource PlaceArrowStyle}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- right column: 26px row, 22px icon, text may wrap to two lines -->
        <DataTemplate x:Key="PlaceTemplate">
            <Button Style="{StaticResource MenuEntryButton}" Height="26" Margin="0,0,0,4"
                    ToolTip="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="22" Height="22" Margin="0,0,3,0"
                           Source="{Binding LargeIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               FontWeight="{Binding TitleWeight}"
                               TextWrapping="Wrap" LineHeight="13"
                               LineStackingStrategy="BlockLineHeight"
                               VerticalAlignment="Center" />
                    <Path Grid.Column="2" Margin="3,0,2,0" VerticalAlignment="Center"
                          Data="M 0,0 L 3.5,3.5 L 0,7 Z"
                          Visibility="{Binding ArrowVisibility}"
                          Style="{StaticResource PlaceArrowStyle}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- group caption in the search results -->
        <DataTemplate x:Key="SearchHeaderTemplate">
            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="5,7,0,3"
                       Foreground="{DynamicResource RightPaneForeground}" />
        </DataTemplate>

        <DataTemplate x:Key="RightSeparatorTemplate">
            <Rectangle Height="1.5" Margin="0,3,0,3"
                       Fill="{DynamicResource RightSeparatorBrush}" />
        </DataTemplate>

        <views:StartItemTemplateSelector x:Key="PlaceSelector"
                                         ItemTemplate="{StaticResource PlaceTemplate}"
                                         SeparatorTemplate="{StaticResource RightSeparatorTemplate}" />

        <!-- a tile in the panel on the right: icon over a wrapped caption -->
        <DataTemplate x:Key="TileTemplate">
            <Button Style="{StaticResource MenuEntryButton}" Width="72" Height="72"
                    Margin="2" Padding="2" ToolTip="{Binding Tooltip}">
                <StackPanel VerticalAlignment="Center">
                    <Grid Width="38" Height="34" HorizontalAlignment="Center">
                        <Image Width="32" Height="32" HorizontalAlignment="Left"
                               Source="{Binding LargeIcon}"
                               Visibility="{Binding IconVisibility}"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- a folder shows what it holds, four icons at a time -->
                        <Border Width="32" Height="32" HorizontalAlignment="Left"
                                CornerRadius="3" Padding="1"
                                Background="{DynamicResource LeftPaneBackground}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ColumnDividerBrush}"
                                Visibility="{Binding PreviewVisibility}">
                            <ItemsControl ItemsSource="{Binding Preview}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Image Width="13" Height="13" Margin="0,0,1,1"
                                               Source="{Binding SmallIcon}"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <!-- a folder tile opens rather than starts, so it says so -->
                        <Path Data="M 0,0 L 4.5,4.5 L 0,9 Z" Stretch="Fill"
                              Width="5" Height="10" Margin="0,0,1,0"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              Visibility="{Binding ArrowVisibility}"
                              Style="{StaticResource PlaceArrowStyle}" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" TextAlignment="Center"
                               TextWrapping="Wrap" MaxHeight="27"
                               LineHeight="13" LineStackingStrategy="BlockLineHeight"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <views:StartItemTemplateSelector x:Key="ResultSelector"
                                         ItemTemplate="{StaticResource LeftItemTemplate}"
                                         SeparatorTemplate="{StaticResource RightSeparatorTemplate}"
                                         HeaderTemplate="{StaticResource SearchHeaderTemplate}" />

        <!-- the same row in the search layout, where there is room for whole paths -->
        <DataTemplate x:Key="WideResultTemplate">
            <Button Style="{StaticResource MenuEntryButton}" Height="34" Margin="0,0,0,4"
                    ToolTip="{Binding Tooltip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="30" Height="30" Margin="0,0,3,0"
                           Source="{Binding LargeIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="{Binding TitleWeight}"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Subtext}"
                                   Visibility="{Binding SubtextVisibility}"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource SubtextStyle}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- one program in the All Programs view: 26px row, room for a long name -->
        <DataTemplate x:Key="ProgramRowTemplate">
            <Button Style="{StaticResource MenuEntryButton}" Height="26" Margin="0,0,6,2"
                    ToolTip="{Binding Tooltip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="22" Height="22" Margin="0,0,4,0"
                           Source="{Binding LargeIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- one group in the list on the left of that view -->
        <DataTemplate x:Key="ProgramGroupTemplate">
            <Button Style="{StaticResource MenuEntryButton}" Height="22" Margin="0,0,0,2"
                    ToolTip="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="16" Height="16" Margin="0,0,5,0"
                           Source="{Binding SmallIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                               FontWeight="{Binding TitleWeight}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Button>
        </DataTemplate>

        <views:StartItemTemplateSelector x:Key="WideResultSelector"
                                         ItemTemplate="{StaticResource WideResultTemplate}"
                                         SeparatorTemplate="{StaticResource RightSeparatorTemplate}"
                                         HeaderTemplate="{StaticResource SearchHeaderTemplate}" />

        <!-- ============ the single column layout of Windows 95 to 2000 ============ -->

        <DataTemplate x:Key="ClassicItemTemplate">
            <Button Style="{StaticResource MenuEntryButton}"
                    Height="{DynamicResource ClassicItemHeight}" Padding="2,0"
                    ToolTip="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="32" Height="32" Margin="2,0,6,0"
                           Source="{Binding LargeIcon}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                               Margin="0,0,20,0" />
                    <Path Grid.Column="2" Margin="0,0,4,0" VerticalAlignment="Center"
                          Data="M 0,0 L 4,4 L 0,8 Z"
                          Visibility="{Binding ArrowVisibility}"
                          Style="{StaticResource PlaceArrowStyle}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ClassicSeparatorTemplate">
            <Grid Height="2" Margin="4,3,4,3">
                <Rectangle Height="1" VerticalAlignment="Top"
                           Fill="{DynamicResource Shadow3DBrush}" />
                <Rectangle Height="1" VerticalAlignment="Bottom"
                           Fill="{DynamicResource Light3DBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ClassicSleepTemplate">
            <Button Style="{StaticResource MenuEntryButton}"
                    Height="{DynamicResource ClassicItemHeight}" Padding="2,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource SleepIconImage}" Width="32" Height="32"
                           Margin="2,0,6,0" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ClassicLogOffTemplate">
            <Button Style="{StaticResource MenuEntryButton}"
                    Height="{DynamicResource ClassicItemHeight}" Padding="2,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource LogOffIconImage}" Width="32" Height="32"
                           Margin="2,0,6,0" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ClassicShutDownTemplate">
            <Button Style="{StaticResource MenuEntryButton}"
                    Height="{DynamicResource ClassicItemHeight}" Padding="2,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource PowerIconImage}" Width="32" Height="32"
                           Margin="2,0,6,0" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <views:StartItemTemplateSelector x:Key="ClassicSelector"
                                         ItemTemplate="{StaticResource ClassicItemTemplate}"
                                         SeparatorTemplate="{StaticResource ClassicSeparatorTemplate}"
                                         SleepTemplate="{StaticResource ClassicSleepTemplate}"
                                         LogOffTemplate="{StaticResource ClassicLogOffTemplate}"
                                         ShutDownTemplate="{StaticResource ClassicShutDownTemplate}" />
    </Window.Resources>

    <Grid>

    <!-- the margin leaves room for the drop shadow on the right -->
    <Border x:Name="Root"
            Margin="0,0,7,0"
            Background="{DynamicResource FrameBrush}"
            CornerRadius="{DynamicResource MenuCornerRadius}"
            SnapsToDevicePixels="True">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="7" ShadowDepth="3" Direction="315" Opacity="0.5" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ header ============ -->
            <Border Grid.Row="0"
                    Height="{DynamicResource HeaderHeight}"
                    Background="{DynamicResource HeaderBackground}"
                    CornerRadius="{DynamicResource MenuCornerRadius}">
                <Grid>
                    <Rectangle Height="3" VerticalAlignment="Top" Margin="0,1,0,0"
                               Fill="{DynamicResource HeaderTopHighlight}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0"
                                Background="Transparent" Cursor="Hand"
                                MouseLeftButtonUp="OnHeaderClick">
                        <Border x:Name="UserTile"
                                Width="48" Height="48" CornerRadius="3" Margin="0,0,6,0"
                                BorderThickness="2"
                                BorderBrush="{DynamicResource UserTileBorder}"
                                Background="#20FFFFFF">
                            <Image x:Name="UserPicture" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock x:Name="UserName" VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="{DynamicResource UserNameFontSize}"
                                   Foreground="{DynamicResource HeaderForeground}">
                            <TextBlock.Effect>
                                <DropShadowEffect ShadowDepth="1.4" Direction="315"
                                                  BlurRadius="1" Opacity="0.7" Color="Black" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ the two columns ============ -->
            <Grid Grid.Row="1" Margin="2,0,2,0">
                <Border x:Name="ColumnsHost" BorderThickness="0,1,0,1"
                        BorderBrush="{DynamicResource MenuTopLineBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- left column -->
                        <Border Grid.Column="0" Padding="5,6,5,0"
                                Background="{DynamicResource LeftPaneBackground}"
                                TextElement.Foreground="{DynamicResource LeftPaneForeground}">
                            <DockPanel x:Name="LeftColumnHost" LastChildFill="True">
                                <StackPanel x:Name="SearchHost" DockPanel.Dock="Bottom"
                                            Margin="0,0,0,5" Visibility="Collapsed">
                                    <Border Background="{DynamicResource SearchBoxBackground}"
                                            BorderBrush="{DynamicResource SearchBoxBorder}"
                                            BorderThickness="1" Padding="3,2">
                                        <Grid>
                                            <TextBox x:Name="SearchBox" BorderThickness="0"
                                                     Background="Transparent" Padding="0"
                                                     Foreground="{DynamicResource SearchBoxForeground}"
                                                     TextChanged="OnSearchTextChanged"
                                                     KeyDown="OnSearchKeyDown" />
                                            <TextBlock x:Name="SearchHint" IsHitTestVisible="False"
                                                       Margin="2,0,0,0"
                                                       Foreground="{DynamicResource SearchHintForeground}" />
                                        </Grid>
                                    </Border>
                                    <CheckBox x:Name="FilesToggle" Margin="1,4,0,0"
                                              Style="{StaticResource RetroCheckBox}"
                                              Click="OnSearchFilesToggled" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <Rectangle Height="1.5" Margin="0,3,0,3"
                                               Fill="{DynamicResource LeftSeparatorBrush}" />
                                    <Button x:Name="AllProgramsButton" Height="24" Margin="0,0,0,4"
                                            Style="{StaticResource MenuEntryButton}"
                                            Click="OnAllProgramsClick">
                                        <StackPanel Orientation="Horizontal" Margin="33,0,0,0">
                                            <TextBlock x:Name="AllProgramsLabel" FontWeight="Bold"
                                                       VerticalAlignment="Center" />
                                            <Path Margin="6,0,0,0" Width="11" Height="13"
                                                  Stretch="Fill" VerticalAlignment="Center"
                                                  Data="M 0,0 L 11,6.5 L 0,13 Z"
                                                  Fill="{StaticResource AllProgramsArrowFill}"
                                                  Stroke="{StaticResource AllProgramsArrowStroke}"
                                                  StrokeThickness="1" StrokeLineJoin="Round" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>


                                <Grid x:Name="ListHost">
                                    <ScrollViewer x:Name="NormalScroll"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="OnResultsWheel">
                                        <StackPanel Button.Click="OnItemClick"
                                                    MouseRightButtonUp="OnItemRightClick"
                                                    MouseMove="OnPlaceHover"
                                                    Background="Transparent"
                                                    AllowDrop="True"
                                                    PreviewMouseLeftButtonDown="OnPinDragStart"
                                                    PreviewMouseMove="OnPinDragMove"
                                                    DragOver="OnPinDragOver"
                                                    DragLeave="OnPinDragLeave"
                                                    Drop="OnPinDrop">
                                            <ItemsControl x:Name="TopItems"
                                                          ItemTemplate="{StaticResource LeftItemTemplate}" />
                                            <Rectangle x:Name="TopSeparator" Height="1.5"
                                                       Margin="0,3,0,3"
                                                       Fill="{DynamicResource LeftSeparatorBrush}" />
                                            <ItemsControl x:Name="FrequentItems"
                                                          ItemTemplate="{StaticResource LeftItemTemplate}" />
                                        </StackPanel>
                                    </ScrollViewer>

                                    <ScrollViewer x:Name="SearchScroll" Visibility="Collapsed"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="OnResultsWheel">
                                        <StackPanel Button.Click="OnItemClick"
                                                    MouseRightButtonUp="OnItemRightClick">
                                            <ItemsControl x:Name="SearchResults"
                                                          ItemTemplateSelector="{StaticResource ResultSelector}" />
                                            <TextBlock x:Name="SearchNote" Margin="6,4,4,0"
                                                       Visibility="Collapsed" Opacity="0.6"
                                                       TextWrapping="Wrap" />
                                            <TextBlock x:Name="NoResults" Margin="6,6,0,0"
                                                       Visibility="Collapsed" Opacity="0.7" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- right column -->
                        <Border Grid.Column="1" Padding="5,6,5,5"
                                Background="{DynamicResource RightPaneBackground}"
                                BorderThickness="1,0,0,0"
                                BorderBrush="{DynamicResource ColumnDividerBrush}"
                                TextElement.Foreground="{DynamicResource RightPaneForeground}"
                                MouseMove="OnPlaceHover">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="PlaceItems"
                                              ItemTemplateSelector="{StaticResource PlaceSelector}"
                                              Button.Click="OnItemClick" />
                            </ScrollViewer>
                        </Border>

                        <!-- third panel: the favourites as tiles, folders included -->
                        <Border Grid.Column="2" x:Name="TilePanel" Width="240"
                                Visibility="Collapsed" Padding="4,6,4,5"
                                Background="{DynamicResource RightPaneBackground}"
                                BorderThickness="1,0,0,0"
                                BorderBrush="{DynamicResource ColumnDividerBrush}"
                                TextElement.Foreground="{DynamicResource RightPaneForeground}"
                                MouseMove="OnPlaceHover"
                                AllowDrop="True"
                                PreviewMouseLeftButtonDown="OnPinDragStart"
                                PreviewMouseMove="OnPinDragMove"
                                DragOver="OnPinDragOver"
                                DragLeave="OnPinDragLeave"
                                Drop="OnPinDrop">
                            <DockPanel>
                                <TextBlock x:Name="TileHeader" DockPanel.Dock="Top"
                                           FontWeight="Bold" Margin="4,1,0,5" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="TileItems"
                                                  ItemTemplate="{StaticResource TileTemplate}"
                                                  Button.Click="OnItemClick"
                                                  MouseRightButtonUp="OnItemRightClick">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" Width="228" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============ the search takes over the whole menu ============ -->
                <Border x:Name="SearchViewHost" Visibility="Collapsed"
                        BorderThickness="0,1,0,1" BorderBrush="{DynamicResource MenuTopLineBrush}">
                    <!-- The height is taken from the columns as the search opens, so
                         the menu only grows sideways and the hits scroll. -->
                    <Grid x:Name="SearchViewGrid" Width="600" Height="376">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="208" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- what to look for: the criteria side, as XP had it -->
                        <Border Grid.Column="0" Padding="8,7,8,6"
                                Background="{DynamicResource LeftPaneBackground}"
                                TextElement.Foreground="{DynamicResource LeftPaneForeground}">
                            <DockPanel>
                                <Button x:Name="BackButton" DockPanel.Dock="Bottom" Height="24"
                                        Style="{StaticResource MenuEntryButton}"
                                        HorizontalContentAlignment="Left"
                                        Click="OnLeaveSearchView">
                                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                        <Path Width="9" Height="11" Stretch="Fill"
                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                              Data="M 9,0 L 0,5.5 L 9,11 Z"
                                              Style="{StaticResource PlaceArrowStyle}" />
                                        <TextBlock x:Name="BackLabel" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <StackPanel>
                                    <TextBlock x:Name="AdvancedTitle" FontWeight="Bold"
                                               Margin="0,0,0,7" />

                                    <TextBlock x:Name="SearchForLabel" Margin="0,0,0,3" />
                                    <Border Background="{DynamicResource SearchBoxBackground}"
                                            BorderBrush="{DynamicResource SearchBoxBorder}"
                                            BorderThickness="1" Padding="3,3" Margin="0,0,0,9">
                                        <TextBox x:Name="AdvancedBox" BorderThickness="0"
                                                 Background="Transparent" Padding="0"
                                                 Foreground="{DynamicResource SearchBoxForeground}"
                                                 TextChanged="OnAdvancedTextChanged"
                                                 KeyDown="OnAdvancedKeyDown" />
                                    </Border>

                                    <TextBlock x:Name="CategoriesLabel" FontWeight="Bold"
                                               Margin="0,0,0,4" />
                                    <CheckBox x:Name="AppsFilter" Margin="1,0,0,3"
                                              Style="{StaticResource RetroCheckBox}"
                                              Checked="OnAdvancedFilterChanged"
                                              Unchecked="OnAdvancedFilterChanged" />
                                    <CheckBox x:Name="SettingsFilter" Margin="1,0,0,3"
                                              Style="{StaticResource RetroCheckBox}"
                                              Checked="OnAdvancedFilterChanged"
                                              Unchecked="OnAdvancedFilterChanged" />
                                    <CheckBox x:Name="FilesFilter" Margin="1,0,0,8"
                                              Style="{StaticResource RetroCheckBox}"
                                              Checked="OnAdvancedFilterChanged"
                                              Unchecked="OnAdvancedFilterChanged" />

                                    <TextBlock x:Name="FileTypeLabel" Margin="0,0,0,3" />
                                    <ComboBox x:Name="FileTypeBox" Margin="0,0,0,8"
                                              SelectionChanged="OnAdvancedFilterChanged" />

                                    <TextBlock x:Name="LocationLabel" Margin="0,0,0,3" />
                                    <ComboBox x:Name="LocationBox" Margin="0,0,0,8"
                                              SelectionChanged="OnAdvancedFilterChanged" />

                                    <TextBlock x:Name="ModifiedLabel" Margin="0,0,0,3" />
                                    <ComboBox x:Name="ModifiedBox" Margin="0,0,0,4"
                                              SelectionChanged="OnAdvancedFilterChanged" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- what came back -->
                        <Border Grid.Column="1" Padding="5,6,4,5"
                                Background="{DynamicResource RightPaneBackground}"
                                BorderThickness="1,0,0,0"
                                BorderBrush="{DynamicResource ColumnDividerBrush}"
                                TextElement.Foreground="{DynamicResource RightPaneForeground}">
                            <DockPanel>
                                <TextBlock x:Name="AdvancedNote" DockPanel.Dock="Top"
                                           Margin="5,0,0,4" Opacity="0.7" TextWrapping="Wrap" />
                                <ScrollViewer x:Name="AdvancedScroll"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="OnResultsWheel">
                                    <StackPanel Button.Click="OnItemClick"
                                                MouseRightButtonUp="OnItemRightClick">
                                        <ItemsControl x:Name="AdvancedResults"
                                                      ItemTemplateSelector="{StaticResource WideResultSelector}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============ All Programs takes over the whole menu ============ -->
                <Border x:Name="ProgramsViewHost" Visibility="Collapsed"
                        BorderThickness="0,1,0,1" BorderBrush="{DynamicResource MenuTopLineBrush}">
                    <!-- Both measurements are set as the view opens: the height the
                         columns had, and as much width as the screen spares, so the
                         programs stand in real columns instead of one long cascade. -->
                    <Grid x:Name="ProgramsViewGrid" Width="640" Height="376">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="208" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- the groups: the folders both Start Menu trees hold -->
                        <Border Grid.Column="0" Padding="8,7,8,6"
                                Background="{DynamicResource LeftPaneBackground}"
                                TextElement.Foreground="{DynamicResource LeftPaneForeground}">
                            <DockPanel>
                                <Button x:Name="ProgramsBackButton" DockPanel.Dock="Bottom" Height="24"
                                        Style="{StaticResource MenuEntryButton}"
                                        HorizontalContentAlignment="Left"
                                        Click="OnLeaveProgramsView">
                                    <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                        <Path Width="9" Height="11" Stretch="Fill"
                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                              Data="M 9,0 L 0,5.5 L 9,11 Z"
                                              Style="{StaticResource PlaceArrowStyle}" />
                                        <TextBlock x:Name="ProgramsBackLabel" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock x:Name="ProgramsTitle" FontWeight="Bold"
                                               Margin="0,0,0,7" />
                                    <TextBlock x:Name="ProgramsFilterLabel" Margin="0,0,0,3" />
                                    <Border Background="{DynamicResource SearchBoxBackground}"
                                            BorderBrush="{DynamicResource SearchBoxBorder}"
                                            BorderThickness="1" Padding="3,3" Margin="0,0,0,9">
                                        <TextBox x:Name="ProgramsFilterBox" BorderThickness="0"
                                                 Background="Transparent" Padding="0"
                                                 Foreground="{DynamicResource SearchBoxForeground}"
                                                 TextChanged="OnProgramsFilterChanged"
                                                 KeyDown="OnProgramsFilterKeyDown" />
                                    </Border>
                                    <TextBlock x:Name="ProgramsGroupsLabel" FontWeight="Bold"
                                               Margin="0,0,0,4" />
                                </StackPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="ProgramGroups"
                                                  ItemTemplate="{StaticResource ProgramGroupTemplate}"
                                                  Button.Click="OnProgramGroupClick" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- the programs themselves, in as many columns as there is room for -->
                        <Border Grid.Column="1" Padding="5,6,4,5"
                                Background="{DynamicResource RightPaneBackground}"
                                BorderThickness="1,0,0,0"
                                BorderBrush="{DynamicResource ColumnDividerBrush}"
                                TextElement.Foreground="{DynamicResource RightPaneForeground}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="2,0,2,5">
                                    <TextBlock x:Name="ProgramsHeader" FontWeight="Bold"
                                               Margin="0,0,60,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ProgramsCount" Opacity="0.7"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <ScrollViewer x:Name="ProgramsScroll"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="OnProgramsWheel"
                                              SizeChanged="OnProgramsResized"
                                              Button.Click="OnItemClick"
                                              MouseRightButtonUp="OnItemRightClick" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Luna's orange hairline, sitting on top of both columns -->
                <Rectangle Height="2" VerticalAlignment="Top" Margin="0,1,0,0"
                           Fill="{DynamicResource OrangeLineBrush}" />
            </Grid>

            <!-- ============ footer ============ -->
            <Border Grid.Row="2"
                    Height="{DynamicResource FooterHeight}"
                    Background="{DynamicResource FooterBackground}"
                    TextElement.Foreground="{DynamicResource FooterForeground}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="SleepButton" Style="{StaticResource FooterItemButton}"
                            Margin="0,0,10,0" Click="OnSleepClick">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource SleepIconImage}" Width="22" Height="22"
                                   Margin="0,0,3,0" />
                            <TextBlock x:Name="SleepLabel" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="LogOffButton" Style="{StaticResource FooterItemButton}"
                            Margin="0,0,10,0" Click="OnLogOffClick">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource LogOffIconImage}" Width="22" Height="22"
                                   Margin="0,0,3,0" />
                            <TextBlock x:Name="LogOffLabel" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ShutDownButton" Style="{StaticResource FooterItemButton}"
                            Margin="0,0,10,0" Click="OnShutDownClick">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource PowerIconImage}" Width="22" Height="22"
                                   Margin="0,0,3,0" />
                            <TextBlock x:Name="ShutDownLabel" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <!-- ============ Windows 95 to 2000: one column, strip on the left ============ -->
    <Border x:Name="ClassicRoot" Visibility="Collapsed"
            Margin="0,0,7,0" MinWidth="196"
            Background="{DynamicResource MenuFaceBrush}"
            BorderBrush="{DynamicResource DarkShadow3DBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="ClassicScale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="315" Opacity="0.45" />
        </Border.Effect>

        <Border BorderThickness="1,1,0,0" BorderBrush="{DynamicResource Light3DBrush}">
            <DockPanel>
                <Border DockPanel.Dock="Left"
                        Width="{DynamicResource BannerWidth}"
                        Background="{DynamicResource BannerBrush}">
                    <TextBlock Text="{DynamicResource BannerText}"
                               Foreground="{DynamicResource BannerForeground}"
                               FontWeight="Bold"
                               FontSize="{DynamicResource BannerFontSize}"
                               VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Margin="0,0,0,7">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>

                <ItemsControl x:Name="ClassicItems" Margin="1,2,2,2"
                              ItemTemplateSelector="{StaticResource ClassicSelector}"
                              Button.Click="OnItemClick"
                              MouseMove="OnPlaceHover" />
            </DockPanel>
        </Border>
    </Border>

    </Grid>
</Window>
